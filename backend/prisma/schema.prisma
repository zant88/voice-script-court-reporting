// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  NEW
  ASSIGNED
  TRANSCRIBED
  REVIEWED
  COMPLETED
}

enum AssignmentType {
  PHYSICAL
  REMOTE
}

enum UserRole {
  REPORTER
  EDITOR
  ADMIN
}

model User {
  id                String    @id @default(uuid(7))
  name              String
  email             String    @unique
  password          String
  role              UserRole  @default(REPORTER)
  location          String
  isAvailable       Boolean   @default(true)
  reportedJobs      Job[]     @relation("ReporterJobs")
  editedJobs        Job[]     @relation("EditorJobs")
  createdJobs       Job[]     @relation("CreatorJobs")
  reporterPayments        Payment[]               @relation("ReporterPayments")
  editorPayments          Payment[]               @relation("EditorPayments")
  transcriptionVersions   TranscriptionVersion[]

  createdAt         DateTime  @default(now())     
}

model Job {
  id                        String          @id @default(uuid(7))
  caseName                  String
  durationMinutes           Int
  assignmentType            AssignmentType  @default(REMOTE)
  location                  String
  reporterId                String?
  reporter                  User?           @relation("ReporterJobs", fields: [reporterId], references: [id], onDelete: Cascade)
  editorId                  String?
  editor                    User?           @relation("EditorJobs", fields: [editorId], references: [id], onDelete: Cascade)
  transcriptionResult       String?
  status                    JobStatus       @default(NEW)
  reporterRatePerMinute     Int
  editorFlatRate            Int
  createdBy                 String
  creator                   User            @relation("CreatorJobs", fields: [createdBy], references: [id], onDelete: Cascade)
  payments                  Payment[]
  transcriptionVersions     TranscriptionVersion[]
  createdAt                 DateTime        @default(now())
  reportedAt                DateTime?
  editedAt                  DateTime?
}

model Payment {
  id                        String          @id @default(uuid(7))
  jobId                     String
  job                       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterId                String          
  reporter                  User            @relation("ReporterPayments", fields: [reporterId], references: [id], onDelete: Cascade)
  editorId                  String
  editor                    User            @relation("EditorPayments", fields: [editorId], references: [id], onDelete: Cascade)
  reporterEarnings          Int
  editorEarnings            Int
  totalPayout               Int
  calculatedAt              DateTime        @default(now())
}

model TranscriptionVersion {
  id                  String   @id @default(uuid(7))
  jobId               String
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content             String
  submittedById       String
  submittedBy         User     @relation(fields: [submittedById], references: [id])
  role                String
  createdAt           DateTime @default(now())
}